# Copy to .env and fill in real values. Never commit the real .env.

# --- LLM providers (fallback chain order: gemini -> groq -> deepseek) ---
# Gemini model: gemini-2.5-flash (verified active on 2026-09-04)
GEMINI_API_KEY=
# Groq model: openai/gpt-oss-20b (verified active on 2026-09-04)
GROQ_API_KEY=
# DeepSeek model: deepseek-chat (verified active; may need credits top-up)
DEEPSEEK_API_KEY=
LLM_PROVIDER_CHAIN=gemini,groq,deepseek
LLM_MAX_RETRIES_PER_PROVIDER=2
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_BACKOFF_CAP_SECONDS=30.0
LLM_MAX_INPUT_TOKENS=6000

# --- GitHub (raises API rate limit from 60/hr to 5000/hr) ---
GITHUB_TOKEN=

# --- Concurrency / scale knobs ---
MAX_CONCURRENT_PER_DOMAIN=5
MAX_GLOBAL_CONCURRENCY=50
REQUEST_TIMEOUT_SECONDS=30

# --- Freshness ---
FRESHNESS_WINDOW_HOURS=24

# --- News LLM extraction (optional, disabled by default to save API calls) ---
# Set USE_LLM_FOR_NEWS=1 to enable LLM extraction for news articles
USE_LLM_FOR_NEWS=0

# --- Storage ---
DATABASE_URL=sqlite:///./data/pipeline.db

# --- Google Sheets export ---
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service_account.json

# --- Source lists (comma-separated; override the defaults in src/config.py) ---
# NEWS_SOURCES=https://example.com/ai-news,...
# JOB_BOARD_SOURCES=https://example.com/jobs,...
